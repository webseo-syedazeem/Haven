{
  "expo": {
    "name": "Haven",
    "slug": "Haven",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "haven",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haven.preview",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
   "android": {
  "package": "com.haven.preview",
  "minSdkVersion": 26,
  "adaptiveIcon": {
    "foregroundImage": "./assets/images/icon.png",
    "backgroundColor": "#16102A"
  },
  "edgeToEdgeEnabled": true,
  "predictiveBackGestureEnabled": false,
  "usesCleartextTraffic": true,
  "jsEngine": "hermes"
} ,
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 250,
          "dark": {
            "backgroundColor": "#16102A",
            "image": "./assets/images/icon.png",
            "imageWidth": 250
          }
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#00000000",
          "barStyle": "dark",
          "position": "absolute",
          "visibility": "visible"
        }
      ],
      "expo-asset",
      "expo-health-connect",
      "react-native-health"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "08fd4b46-0da6-4bfa-bb6a-ccf6cfaa634a"
      }
    }
  }
}
