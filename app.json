{
  "expo": {
    "name": "Passage",
    "slug": "Passage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/passage-brand-assets/icon.png",
    "scheme": "passage",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.happycheeksltd.halcyon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.happycheeksltd.halcyon",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/passage-brand-assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0D"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "jsEngine": "hermes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/passage-brand-assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/passage-brand-assets/notification-icon.png",
          "color": "#0B0B0D",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.31808509810-rreep0tjd63s7gvrc9ft1u554tg3auq1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/images/passage-brand-assets/splash-icon.png",
          "imageWidth": 250,
          "dark": {
            "backgroundColor": "#0B0B0D",
            "image": "./assets/images/passage-brand-assets/splash-icon.png",
            "imageWidth": 250
          }
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "barStyle": "light",
          "visibility": "visible"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-expo-audio-stop-with-app",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7c3de45f-9321-49af-a1e8-7e69d554ec37"
      }
    }
  }
}
